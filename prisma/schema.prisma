datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  PARTNER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PoliceVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  IN_PROGRESS
  VERIFIED
  REJECTED
  EXPIRED
}

enum GovernmentIdType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  phone          String?         @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  role           Role            @default(USER)
  isActive       Boolean         @default(true)
  referralCode   String?         @unique
  referredById   String?
  referredBy     User?           @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]          @relation("UserReferrals")
  partnerProfile PartnerProfile?
  refreshTokens  RefreshToken[]
  consents       UserConsent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([referralCode])
}

model UserConsent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentSlug String
  version      String
  acceptedAt   DateTime  @default(now())
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([documentSlug])
  @@index([userId, documentSlug])
}

model PartnerProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?            @unique
  companyName       String             @default("")
  businessRegNumber String?
  businessCategory  String?
  status            PartnerStatus      @default(PENDING)
  commissionRate    Float              @default(10.0)
  referralCode      String?            @unique
  referredById      String?
  referredBy        PartnerProfile?    @relation("PartnerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         PartnerProfile[]   @relation("PartnerReferrals")
  verifiedAt        DateTime?
  onboarding        PartnerOnboarding?
  machines          PartnerMachine[]
  consents          PartnerConsent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyName])
  @@index([status])
  @@index([phone])
  @@index([referralCode])
}

model PartnerConsent {
  id           String         @id @default(uuid())
  partnerId    String
  partner      PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  documentSlug String
  version      String
  acceptedAt   DateTime       @default(now())
  ip           String?
  userAgent    String?
  createdAt    DateTime       @default(now())

  @@index([partnerId])
  @@index([documentSlug])
  @@index([partnerId, documentSlug])
}

model PartnerOnboarding {
  id                       String                   @id @default(uuid())
  partnerProfileId         String                   @unique
  partnerProfile           PartnerProfile           @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)

  // Personal KYC Details
  fullName                 String?
  fatherOrSpouseName       String?
  dob                      String?
  gender                   String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Current Address & Jurisdiction
  currentAddress           String?
  currentLandmark          String?
  currentCity              String?
  currentState             String?
  currentPincode           String?
  residingSinceYear        Int?

  // Permanent Address
  isPermanentSameAsCurrent Boolean                  @default(false)
  permanentAddress         String?
  permanentLandmark        String?
  permanentCity            String?
  permanentState           String?
  permanentPincode         String?

  // Government ID Details
  idType                   GovernmentIdType?
  idNumber                 String?
  idDocumentUrl            String?
  idDocumentBackUrl        String?

  // Police Verification Details
  policeStationName        String?
  policeStationDistrict    String?
  policeStationState       String?
  policeStationPincode     String?
  pvcCertificateNumber     String?
  pvcDocumentUrl           String?
  pvcIssuedDate            DateTime?
  pvcExpiryDate            DateTime?
  hasCriminalRecord        Boolean                  @default(false)
  criminalRecordDetails    String?
  policeVerificationStatus PoliceVerificationStatus @default(NOT_SUBMITTED)
  policeRemarks            String?
  policeVerifiedAt         DateTime?
  policeVerifiedBy         String?

  // Bank Account Details for Payouts
  bankAccountNumber        String?
  bankIfscCode             String?
  bankName                 String?
  bankAccountHolderName    String?

  // Optional Vehicle / Driving Details
  vehicleType              String?
  vehiclePlateNumber       String?
  drivingLicenseNumber     String?
  drivingLicenseUrl        String?

  // Onboarding Overall State
  status                   OnboardingStatus         @default(DRAFT)
  submissionDate           DateTime?
  rejectionReason          String?
  reviewedBy               String?
  reviewedAt               DateTime?

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([partnerProfileId])
  @@index([status])
  @@index([policeVerificationStatus])
}

model PartnerOtp {
  id        String   @id @default(uuid())
  phone     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model UserOtp {
  id        String   @id @default(uuid())
  phone     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Category {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String    @unique
  description    String?
  iconUrl        String?
  imageUrl       String?
  bannerUrl      String?
  mobileImageUrl String?
  webImageUrl    String?
  isActive       Boolean   @default(true)
  displayOrder   Int       @default(0)
  machines       Machine[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Machine {
  id             String    @id @default(uuid())
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  slug           String    @unique
  description    String?
  imageUrl       String?
  bannerUrl      String?
  mobileImageUrl String?
  webImageUrl    String?
  specifications Json?
  isActive       Boolean   @default(true)
  displayOrder   Int              @default(0)
  partnerMachines PartnerMachine[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
}

model PartnerMachine {
  id               String         @id @default(uuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  machineId        String
  machine          Machine        @relation(fields: [machineId], references: [id], onDelete: Cascade)

  // Pricing in INR
  hourlyPrice      Float?
  dailyPrice       Float?
  weeklyPrice      Float?
  monthlyPrice     Float?

  // Additional rental policies & operational settings
  minBookingPeriod String?
  operatorIncluded Boolean        @default(false)
  fuelPolicy       String?        // WET, DRY, ELECTRIC, NA
  securityDeposit  Float?
  quantity         Int            @default(1)
  isActive         Boolean        @default(true)
  notes            String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([partnerProfileId, machineId])
  @@index([partnerProfileId])
  @@index([machineId])
  @@index([isActive])
}

